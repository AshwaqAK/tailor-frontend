{
  "name": "tailor-frontend",
  "version": "0.1.0",
  "description": "Production-ready Angular frontend for the Tailor Management System",
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=26.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 5173 --proxy-config proxy.conf.json",
    "build": "ng build --configuration production",
    "build:development": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --coverage",
    "e2e": "playwright test",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run test:ci && npm run build"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-browser-dynamic": "^22.2.1",
    "@angular/router": "^22.2.1",
    "bootstrap": "^5.3.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.5.0",
    "@angular-eslint/eslint-plugin": "22.5.0",
    "@angular-eslint/eslint-plugin-template": "22.5.0",
    "@angular-eslint/schematics": "22.5.0",
    "@angular-eslint/template-parser": "22.5.0",
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.55.1",
    "@typescript-eslint/utils": "8.71.0",
    "@vitest/coverage-v8": "5.0.3",
    "angular-eslint": "22.5.0",
    "eslint": "9.39.5",
    "jsdom": "30.1.1",
    "prettier": "3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
